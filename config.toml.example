# my-agent configuration
#
# Resolution order (first-found wins):
#   1. --config <path> CLI flag
#   2. ./config.toml (cwd)
#   3. ~/.my-agent/config.toml (home default)
#
# Settings in ~/.my-agent/config.toml act as personal defaults.
# A ./config.toml in a specific project directory overrides them.

[llm]
# OpenRouter model slug only — code prefixes with "openrouter:"
model = "anthropic/claude-sonnet-4-6"
temperature = 0

[agent]
root_dir = "~"
# Optional override; if empty, AGENTS.md content (home + cwd) is used as the
# base system prompt. When set, it replaces all AGENTS.md content.
system_prompt = ""

[security]
require_approval = true

[paths]
# These directories hold persistent data. Defaults are all under ~/.my-agent/
# so they are consistent regardless of your working directory.
agent_state_dir = "~/.my-agent"
skills_user_dir = "~/.my-agent/skills"
skills_project_dir = "./skills"
chroma_dir = "~/.my-agent/chroma"

[checkpoint]
# "sqlite" persists chat threads across restarts; "memory" is in-process only.
backend = "sqlite"
sqlite_path = "checkpoints.sqlite"
# Retention for `my-agent threads prune` (0 = unlimited / disabled).
max_threads = 50
max_thread_age_days = 0

[store]
# "sqlite" persists /memories/ files across restarts; "memory" is in-process only.
backend = "sqlite"
sqlite_path = "store.sqlite"

[memory]
collection_name = "conversations"
embedding_model = "sentence-transformers/all-MiniLM-L6-v2"
index_on_each_turn = true

[tavily]
max_results = 5
topic = "general"
search_depth = "basic"
include_answer = false
include_raw_content = false

[mcp]
# Enable/disable MCP server integration (default: true)
# enabled = true

# Define MCP servers the agent can use.
# Each server needs a unique name and transport type.
# Servers from ~/.my-agent/config.toml and ./config.toml are merged;
# cwd servers override home servers with the same name.
#
# Stdio transport (local subprocess):
# [[mcp.servers]]
# name = "filesystem"
# transport = "stdio"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
#
# HTTP transport (remote server — also accepts "streamable_http" / "streamable-http"):
# [[mcp.servers]]
# name = "weather"
# transport = "http"
# url = "http://localhost:8000/mcp"
# headers = { Authorization = "Bearer ${MCP_WEATHER_TOKEN}" }
#
# SSE transport (Server-Sent Events):
# [[mcp.servers]]
# name = "sse-server"
# transport = "sse"
# url = "http://localhost:8000/mcp/sse"
# headers = { Authorization = "Bearer ${MCP_SSE_TOKEN}" }
#
# WebSocket transport:
# [[mcp.servers]]
# name = "ws-server"
# transport = "websocket"
# url = "ws://localhost:8000/mcp"

[display]
show_reasoning = true
show_tool_calls = true
show_tool_results = true
show_skills = true
tool_result_max_chars = 500

[summarization]
# When enabled, older conversation turns are automatically summarized to
# keep the context window small. Triggered when non-system messages exceed
# max_messages — older messages are replaced with a single summary.
# Set enabled = false to disable.
enabled = true
max_messages = 30
keep_last = 10
# Optional: use a different (cheaper) model for summarization.
# Leave empty to use the [llm].model.
model = ""
temperature = 0.0