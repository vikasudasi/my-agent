[llm]
# OpenRouter model slug only — code prefixes with "openrouter:"
model = "anthropic/claude-sonnet-4-6"
temperature = 0

[agent]
root_dir = "~"
# Optional override; if empty, AGENTS.md content is used as the base system prompt.
system_prompt = ""

[security]
require_approval = true

[paths]
agent_state_dir = "~/.my-agent"
skills_user_dir = "~/.my-agent/skills"
skills_project_dir = "./skills"
chroma_dir = "~/.my-agent/chroma"

[memory]
collection_name = "conversations"
embedding_model = "sentence-transformers/all-MiniLM-L6-v2"
index_on_each_turn = true

[tavily]
max_results = 5
topic = "general"
search_depth = "basic"
include_answer = false
include_raw_content = false

[display]
show_reasoning = true
show_tool_calls = true
show_tool_results = true
show_skills = true
tool_result_max_chars = 500
